{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/f2c-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/digital-marketing-agency-mathikere",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/digital-marketing-agency-mathikere/",
      "destination": "/",
      "permanent": true
    }
  ]
}
